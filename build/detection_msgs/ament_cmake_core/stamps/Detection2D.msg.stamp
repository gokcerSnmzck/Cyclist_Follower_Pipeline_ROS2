# Detection2D.msg

# Unique tracking ID (from DeepStream tracker)
int32 tracking_id

# Detected object class (e.g., person = 0)
int32 class_id

# Human-readable label, e.g., "person"
string label

# Confidence score (0.0 to 1.0)
float32 confidence

# 2D bounding box in image coordinates
BoundingBox2D bbox
